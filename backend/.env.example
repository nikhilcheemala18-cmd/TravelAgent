APP_ENV=development
MOCK_MODE=true

# Populate these when integrating real travel provider APIs.
FLIGHT_PROVIDER_API_KEY=
HOTEL_PROVIDER_API_KEY=
CAR_RENTAL_PROVIDER_API_KEY=

# LLM provider used by the Planner's slot extractor (app/llm/factory.py).
# "mock" runs fully offline with no credentials — good for local dev.
# Set to "openai" (or another registered provider) to use a real model.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only used by providers that support an OpenAI-compatible endpoint
# (e.g. a local Ollama server) — leave empty to use the provider default.
LLM_BASE_URL=

# FallbackManager retry policy for transient tool failures (execution
# errors / timeouts only — structural failures like a missing tool are
# never retried). Set FALLBACK_MAX_RETRIES=0 to disable retries.
FALLBACK_MAX_RETRIES=2
FALLBACK_RETRY_DELAY_MS=250
